<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ديوان العصر العباسي | التراث الزاهر</title>
    <style>
        :root {
            --bg-primary: #120f0b;
            --bg-secondary: #1e1812;
            --bg-card: #282017;
            --accent-gold: #d4af37;
            --accent-gold-light: #f3e5ab;
            --text-main: #f4ebd0;
            --text-muted: #b8a88a;
            --border-gold: #8c733f;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Traditional Arabic', 'Amiri', 'Times New Roman', serif;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* رأس الصفحة الطرازي */
        header {
            background: linear-gradient(to bottom, var(--bg-secondary), var(--bg-primary));
            border-bottom: 2px solid var(--border-gold);
            padding: 25px 20px;
            text-align: center;
            position: relative;
        }

        header h1 {
            color: var(--accent-gold);
            font-size: 2.5rem;
            letter-spacing: 1px;
            margin-bottom: 8px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.6);
        }

        header p {
            color: var(--text-muted);
            font-size: 1.2rem;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            padding: 0 20px;
            flex: 1;
            width: 100%;
        }

        /* شاشات المصادقة (تسجيل الدخول) */
        .auth-box {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-gold);
            border-radius: 12px;
            padding: 30px;
            max-width: 450px;
            margin: 50px auto;
            box-shadow: 0 10px 25px rgba(0,0,0,0.7);
        }

        .auth-box h2 {
            color: var(--accent-gold);
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.8rem;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--text-muted);
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            background-color: var(--bg-primary);
            border: 1px solid var(--border-gold);
            border-radius: 6px;
            color: var(--text-main);
            font-size: 1rem;
        }

        .btn {
            background: linear-gradient(135deg, var(--accent-gold), #aa8c2c);
            color: #120f0b;
            border: none;
            padding: 12px;
            width: 100%;
            border-radius: 6px;
            font-weight: bold;
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn:hover {
            background: var(--accent-gold-light);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.5);
        }

        /* لوحة التحكم الجانبية وبيانات المستخدم */
        .dashboard-header {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-gold);
            padding: 20px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .user-credentials {
            font-size: 1.1rem;
        }

        .user-credentials span {
            color: var(--accent-gold);
            font-weight: bold;
        }

        /* نموذج نشر محتوى جديد (خاص بالمدير الصلاحيات الكاملة) */
        .publisher-section {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-gold);
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 40px;
        }

        .publisher-section h3 {
            color: var(--accent-gold);
            margin-bottom: 15px;
            font-size: 1.4rem;
        }

        .publisher-section textarea {
            width: 100%;
            height: 100px;
            padding: 12px;
            background-color: var(--bg-primary);
            border: 1px solid var(--border-gold);
            border-radius: 6px;
            color: var(--text-main);
            margin-bottom: 15px;
            resize: vertical;
        }

        /* شبكة الشخصيات والتاريخ العباسي */
        .section-title {
            color: var(--accent-gold);
            font-size: 1.8rem;
            border-bottom: 1px solid var(--border-gold);
            padding-bottom: 8px;
            margin-bottom: 25px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 40px;
        }

        .card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-gold);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-gold-light);
        }

        .card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-bottom: 1px solid var(--border-gold);
            filter: sepia(30%);
        }

        .card-content {
            padding: 20px;
        }

        .card-content h4 {
            color: var(--accent-gold);
            font-size: 1.3rem;
            margin-bottom: 10px;
        }

        .card-content p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
        }

        /* قسم المنشورات الديناميكية */
        .posts-feed {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 40px;
        }

        .post-item {
            background-color: var(--bg-card);
            border: 1px dashed var(--border-gold);
            padding: 20px;
            border-radius: 8px;
        }

        .post-item p {
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 10px;
        }

        .post-author {
            color: var(--accent-gold);
            font-size: 0.95rem;
            text-align: left;
        }

        /* ذيل الصفحة المخصص */
        footer {
            background-color: var(--bg-secondary);
            border-top: 2px solid var(--border-gold);
            text-align: center;
            padding: 20px;
            color: var(--text-muted);
            margin-top: auto;
            font-size: 1.1rem;
        }

        footer span {
            color: var(--accent-gold);
            font-weight: bold;
        }

        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>

    <header>
        <h1>ديوان العصر العباسي</h1>
        <p>نافذة على أزهى عصور المعرفة والحضارة الإسلامية</p>
    </header>

    <div class="container">
        <!-- شاشة تسجيل الدخول -->
        <div id="authScreen" class="auth-box">
            <h2>دخول الديوان</h2>
            <div class="form-group">
                <label>البريد الإلكتروني:</label>
                <input type="email" id="emailInput" placeholder="أدخل بريدك الإلكتروني..." required>
            </div>
            <div class="form-group">
                <label>كلمة المرور:</label>
                <input type="password" id="passwordInput" placeholder="أدخل كلمة المرور..." required>
            </div>
            <button class="btn" onclick="handleLogin()">دخول بصلاحيات الإدارة الكاملة</button>
        </div>

        <!-- المحتوى الرئيسي (يظهر بعد الدخول) -->
        <div id="mainApp" class="hidden">
            <!-- معلومات حساب المستخدم والتحكم -->
            <div class="dashboard-header">
                <div class="user-credentials">
                    البريد المُسجّل: <span id="displayEmail"></span> | 
                    كلمة المرور: <span id="displayPassword"></span>
                </div>
                <button class="btn" style="width: auto; padding: 8px 15px;" onclick="handleLogout()">تسجيل الخروج</button>
            </div>

            <!-- أيقونة / أداة النشر (بصلاحيات الإدارة الكاملة) -->
            <div class="publisher-section">
                <h3>إضافة منشور أو مقال جديد في الديوان</h3>
                <textarea id="postContentInput" placeholder="اكتب ما تحب أن تنشره في الموقع من فوائد أو أشعار أو إضاءات تاريخية..."></textarea>
                <button class="btn" onclick="publishNewContent()">نشر المحتوى فوراً</button>
            </div>

            <!-- عرض المنشورات الجديدة -->
            <div id="dynamicFeedContainer" class="posts-feed hidden">
                <h3 class="section-title">منشورات الديوان المُضافة</h3>
                <div id="postsList"></div>
            </div>

            <!-- عرض عشر شخصيات في العصر العباسي بطابع عريق -->
            <h3 class="section-title">أعلام وأعلام العصر العباسي (عشر شخصيات خلدها التاريخ)</h3>
            <div class="cards-grid">
                
                <div class="card">
                    <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=600&q=80" alt="هارون الرشيد">
                    <div class="card-content">
                        <h4>الخليفة هارون الرشيد</h4>
                        <p>خامس الخلفاء العباسيين، عهدُه ذهبي ازدهرت فيه التجارة والعلم وبُنيت "بيت الحكمة".</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80" alt="المأمون">
                    <div class="card-content">
                        <h4>الخليفة المأمون بن الرشيد</h4>
                        <p>راعي حركة الترجمة والعلم والفلك، وشهد عصره أوج الانفتاح المعرفي والعقلي.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1532012197267-da84d127e765?auto=format&fit=crop&w=600&q=80" alt="الجاحظ">
                    <div class="card-content">
                        <h4>الأديب الجاحظ</h4>
                        <p>أبو عثمان عمرو بن بحر، إمام الأدب وكاتب كتاب "الحيوان" و"البخلاء".</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=600&q=80" alt="الخوارزمي">
                    <div class="card-content">
                        <h4>محمد بن موسى الخوارزمي</h4>
                        <p>أبو الجبر ومؤسس علم الخوارزميات والرياضيات الحديثة في بغداد العباسية.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=600&q=80" alt="أبو الطيب المتنبي">
                    <div class="card-content">
                        <h4>الشاعر أبو الطيب المتنبي</h4>
                        <p>ملء الساعات وشاعر العرب الأكبر، صاحب أسمى قصائد الفخر والحكمة.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1516979187457-637abb4f9353?auto=format&fit=crop&w=600&q=80" alt="ابن سينا">
                    <div class="card-content">
                        <h4>الشيخ الرئيس ابن سينا</h4>
                        <p>طبيب وفيلسوف العصر العباسي، صاحب كتاب "القانون في الطب".</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=600&q=80" alt="أبو نصر الفارابي">
                    <div class="card-content">
                        <h4>الفيلسوف الفارابي</h4>
                        <p>المعلم الثاني، وضع أسس الفلسفة الإسلامية وعلم الموسيقى والمنطق.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1513542789411-b6a5d4f31634?auto=format&fit=crop&w=600&q=80" alt="أبو حامد الغزالي">
                    <div class="card-content">
                        <h4>حجة الإسلام الغزالي</h4>
                        <p>الفقيه والفيلسوف والأصولي الكبير، أحد أعظم أعلام الفكر الإسلامي.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=600&q=80" alt="ابن خلدون">
                    <div class="card-content">
                        <h4>العلامة ابن خلدون</h4>
                        <p>مؤسس علم الاجتماع الحديث وصاحب المقدمة التاريخية الشهيرة.</p>
                    </div>
                </div>

                <div class="card">
                    <img src="https://images.unsplash.com/photo-1471107340929-a87cb0f2b2f9?auto=format&fit=crop&w=600&q=80" alt="أبو العتاهية">
                    <div class="card-content">
                        <h4>الشاعر أبو العتاهية</h4>
                        <p>شاعر الزهد والحكمة، تميزت أشعاره بالبساطة والعمق الروحي المؤثر.</p>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- تذييل الصفحة مع اسم المطور وصاحب الموقع -->
    <footer>
        <p>جميع الحقوق محفوظة © 2026 | صاحب الموقع والمنشئ: <span>عبد الله ميري</span></p>
    </footer>

    <script>
        // خوارزمية وحركات التشغيل والتخزين المحلي
        function handleLogin() {
            const email = document.getElementById('emailInput').value.trim();
            const password = document.getElementById('passwordInput').value.trim();

            if (!email || !password) {
                alert('الرجاء إدخال البريد الإلكتروني وكلمة المرور للمتابعة.');
                return;
            }

            // حفظ بيانات المستخدم وعرضها فوراً
            localStorage.setItem('abbid_user_email', email);
            localStorage.setItem('abbid_user_pass', password);

            showAppInterface(email, password);
        }

        function showAppInterface(email, password) {
            document.getElementById('authScreen').classList.add('hidden');
            document.getElementById('mainApp').classList.remove('hidden');
            
            document.getElementById('displayEmail').innerText = email;
            document.getElementById('displayPassword').innerText = password;

            loadSavedPosts();
        }

        function handleLogout() {
            localStorage.removeItem('abbid_user_email');
            localStorage.removeItem('abbid_user_pass');
            location.reload();
        }

        function publishNewContent() {
            const content = document.getElementById('postContentInput').value.trim();
            if (!content) {
                alert('الرجاء كتابة نص النشر أولاً.');
                return;
            }

            let posts = JSON.parse(localStorage.getItem('abbid_posts') || '[]');
            posts.unshift({
                text: content,
                date: new Date().toLocaleDateString('ar-DZ')
            });

            localStorage.setItem('abbid_posts', JSON.stringify(posts));
            document.getElementById('postContentInput').value = '';
            loadSavedPosts();
        }

        function loadSavedPosts() {
            let posts = JSON.parse(localStorage.getItem('abbid_posts') || '[]');
            const container = document.getElementById('dynamicFeedContainer');
            const list = document.getElementById('postsList');

            if (posts.length > 0) {
                container.classList.remove('hidden');
                list.innerHTML = posts.map(p => `
                    <div class="post-item">
                        <p>${p.text}</p>
                        <div class="post-author">تاريخ النشر: ${p.date} — نُشر بواسطة صاحب الموقع: <strong>عبد الله ميري</strong></div>
                    </div>
                `).join('');
            } else {
                container.classList.add('hidden');
            }
        }

        // التحقق التلقائي إذا كان المستخدم مسجلاً مسبقاً
        window.onload = function() {
            const savedEmail = localStorage.getItem('abbid_user_email');
            const savedPass = localStorage.getItem('abbid_user_pass');
            if (savedEmail && savedPass) {
                showAppInterface(savedEmail, savedPass);
            }
        };
    </script>
</body>
</html>
